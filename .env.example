# Copie este arquivo para .env. Nunca envie .env para o Git.

# Opcional: URL pública da live cujo chat será lido ao iniciar o servidor.
# Nenhuma chave de API é necessária para esta leitura pública.
YOUTUBE_LIVE_URL=

# Opcional: somente o servidor usa estes dados para enviar mídia ao YouTube.
# Não coloque a chave de transmissão no navegador nem a compartilhe.
YOUTUBE_RTMPS_URL=rtmps://a.rtmps.youtube.com:443/live2
YOUTUBE_STREAM_KEY=

# A imagem transmitida é o canvas Three.js capturado pelo navegador local.
# Não é necessário configurar um arquivo de vídeo de origem.
